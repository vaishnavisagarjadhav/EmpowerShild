"""
Convert a trained Keras model (.h5) to TensorFlow Lite for on-device,
offline inference in the Flutter app (matches "On-Device Offline AI"
requirement from the competitor comparison table).

Usage:
    python convert_to_tflite.py --model fall_detection_model.h5 --out fall_detection.tflite
"""
import argparse
import tensorflow as tf


def convert(model_path: str, out_path: str, quantize: bool = True):
    model = tf.keras.models.load_model(model_path)
    converter = tf.lite.TFLiteConverter.from_keras_model(model)

    if quantize:
        converter.optimizations = [tf.lite.Optimize.DEFAULT]

    tflite_model = converter.convert()

    with open(out_path, "wb") as f:
        f.write(tflite_model)

    print(f"TFLite model written to {out_path} ({len(tflite_model) / 1024:.1f} KB)")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--model", required=True, help="Path to trained .h5 model")
    parser.add_argument("--out", required=True, help="Output .tflite path")
    parser.add_argument("--no-quantize", action="store_true")
    args = parser.parse_args()

    convert(args.model, args.out, quantize=not args.no_quantize)
